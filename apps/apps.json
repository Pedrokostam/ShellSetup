{
   "$schema": "./schema.json",
   "platformInstallers": {
      "windows": {
         "default": "winget",
         "installers": [
            {
               "name": "winget",
               "command": "winget install --id ${name} --accept-package-agreements -e --scope user -h --source winget",
               "elevated": null
            },
            {
               "name": "scoop",
               "prepare": [
                  "${NEWEST_POWERSHELL}",
                  "-file",
                  "~/scoop/shims/scoop.ps1",
                  "-V"
               ],
               "command": [
                  "${NEWEST_POWERSHELL}",
                  "-file",
                  "~/scoop/shims/scoop.ps1",
                  "install",
                  "$name",
                  "--no-update-scoop"
               ],
               "elevated": false
            }
         ]
      },
      "debian": {
         "installers": [
            {
               "name": "apt-get",
               "command": "apt-get install --yes $name",
               "elevated": true
            }
         ]
      },
      "fedora": {
         "installers": [
            {
               "name": "dnf",
               "command": "dnf install -y $name",
               "elevated": true
            }
         ]
      },
      "opensuse": {
         "installers": [
            {
               "name": "zypper",
               "command": "zypper --non-interactive install $name",
               "elevated": true
            }
         ]
      },
      "arch": {
         "default": "pacman",
         "installers": [
            {
               "name": "pacman",
               "prepare": "pacman -Syq",
               "command": "pacman -Sq --needed --noconfirm $name",
               "elevated": true
            },
            {
               "name": "yay",
               "prepare": "yay -Syq",
               "command": "yay -Sq --needed --noconfirm $name",
               "elevated": true
            }
         ]
      },
      "any": {
         "installers": [
            {
               "name": "npm",
               "command": "npm install -g $name",
               "elevated": {
                  "default": true,
                  "windows": null
               }
            }
         ]
      }
   },
   "apps": [
      {
         "name": "unzip",
         "group": "linux-core",
         "linux": true
      },
      {
         "name": "coreutils",
         "description": "Includes realpath and dirname for OMP. They should be always present anyway.",
         "group": "linux-core",
         "linux": true
      },
      {
         "name": "curl",
         "group": "core",
         "linux": true,
         "windows": {
            "name": "cURL.cURL"
         }
      },
      {
         "name": "scoop",
         "group": "package_managers",
         "windows": {
            "elevated": false,
            "command": "powershell.exe -ExecutionPolicy RemoteSigned -Command \"Invoke-RestMethod -Uri 'https://get.scoop.sh' | Invoke-Expression\""
         }
      },
      {
         "name": "yay",
         "group": "package_managers",
         "windows": false,
         "arch": {
            "script": "arch_yay_install_script.sh",
            "elevated": true
         }
      },
      {
         "name": "flatpak",
         "group": "package_managers",
         "linux": true
      },
      {
         "name": "npm",
         "group": "package_managers",
         "windows": {
            "name": "OpenJS.NodeJS"
         },
         "linux": {
            "name": "nodejs npm"
         }
      },
      {
         "name": "oh-my-posh",
         "group": "cli",
         "windows": true,
         "linux": {
            "command": "curl -s https://ohmyposh.dev/install.sh | bash -s"
         }
      },
      {
         "name": "fastfetch",
         "group": "cli",
         "windows": {
            "name": "Fastfetch-cli.Fastfetch"
         },
         "linux": true
      },
      {
         "name": "git",
         "windows": {
            "name": "Git.Git"
         },
         "linux": true
      },
      {
         "name": "Notepad++",
         "group": "editors",
         "windows": {
            "name": "Notepad++.Notepad++"
         }
      },
      {
         "name": "jq",
         "group": "cli",
         "windows": {
            "name": "jqlang.jq"
         },
         "linux": true
      },
      {
         "name": "yazi",
         "group": "cli",
         "windows": {
            "name": "sxyazi.yazi"
         },
         "arch": true,
         "debian": {
            "script": "debian_yazi_install_script.sh",
            "elevated": true
         },
         "fedora": {
            "script": "fedora_yazi_install_script.sh"
         }
      },
      {
         "name": "ffmpeg",
         "group": "utilities",
         "windows": {
            "name": "Gyan.FFmpeg"
         },
         "any": true
      },
      {
         "name": "poppler",
         "group": "utilities",
         "windows": {
            "name": "oschwartz10612.Poppler"
         },
         "any": true
      },
      {
         "name": "fd",
         "group": "utilities",
         "windows": {
            "name": "sharkdp.fd"
         },
         "any": true
      },
      {
         "name": "resvg",
         "group": "utilities",
         "windows": {
            "installer": "scoop"
         },
         "any": true
      },
      {
         "name": "imagemagick",
         "checkName": "magick",
         "group": "utilities",
         "windows": {
            "name": "ImageMagick.ImageMagick"
         },
         "any": true
      },
      {
         "name": "7zip",
         "group": "utilities",
         "windows": {
            "name": "7zip.7zip"
         },
         "any": true
      },
      {
         "name": "ripgrep",
         "checkName": "rg",
         "group": "cli",
         "windows": {
            "name": "BurntSushi.ripgrep"
         },
         "linux": true
      },
      {
         "name": "micro",
         "group": "editors",
         "windows": {
            "name": "zyedidia.micro"
         },
         "linux": true
      },
      {
         "name": "zoxide",
         "group": "cli",
         "windows": {
            "name": "ajeetdsouza.zoxide"
         },
         "linux": {
            "elevated": false,
            "command": "curl -sSfL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | sh"
         }
      },
      {
         "name": "fzf",
         "group": "cli",
         "windows": {
            "name": "junegunn.fzf"
         },
         "linux": true
      },
      {
         "name": "firefox",
         "windows": {
            "name": "Mozilla.Firefox"
         },
         "opensuse": {
            "name": "MozillaFirefox"
         },
         "linux": true
      },
      {
         "name": "fish",
         "group": "shells",
         "windows": false,
         "arch": true,
         "fedora": true,
         "ubuntu": {
            "elevated": true,
            "command": "sudo add-apt-repository ppa:fish-shell/release-4; sudo apt-get update -y; sudo apt-get install -y fish"
         }
      },
      {
         "name": "PowerShell",
         "group": "shells",
         "checkName": "pwsh",
         "windows": {
            "name": "Microsoft.PowerShell"
         },
         "debian": {
            "script": "debian_pwsh_install_script.sh",
            "elevated": true
         },
         "arch": {
            "installer": "yay",
            "name": "powershell-bin"
         },
         "opensuse": {
            "script": "opensuse_pwsh_install_script.sh",
            "elevated": true
         },
         "fedora": {
            "script": "fedora_pwsh_install_script.sh",
            "elevated": true
         }
      },
      {
         "name": "neovim",
         "group": "editors",
         "checkName": "nvim",
         "windows": {
            "name": "Neovim.Neovim"
         },
         "any": true
      },
      {
         "name": "neovide",
         "group": "editors",
         "windows": {
            "name": "Neovide.Neovide"
         },
         "arch": true
      },
      {
         "name": "IrfanView",
         "group": "viewers",
         "windows": {
            "name": "IrfanSkiljan.IrfanView"
         }
      },
      {
         "name": "uv",
         "group": "package_managers",
         "windows": {
            "name": "astral-sh.uv"
         },
         "linux": {
            "elevated": false,
            "command": "curl -LsSf https://astral.sh/uv/install.sh | sh"
         }
      },
      {
         "name": "ruff",
         "group": "lsp",
         "windows": {
            "name": "astral-sh.ruff"
         },
         "linux": {
            "elevated": false,
            "command": "curl -LsSf https://astral.sh/ruff/install.sh | sh"
         }
      },
      {
         "name": "wingety____SDF",
         "group": "test",
         "windows": {
            "installer": "winget"
         }
      },
      {
         "name": "scoopy____SDf",
         "group": "test",
         "windows": {
            "installer": "scoop"
         }
      },
      {
         "name": "npmy_____asfd",
         "group": "test",
         "any": {
            "installer": "npm"
         }
      },
      {
         "name": "pyright",
         "group": "lsp",
         "windows": {
            "elevated": null,
            "installer": "npm"
         },
         "linux": {
            "elevated": true,
            "installer": "npm"
         }
      },
      {
         "name": "vscode-langservers-extracted",
         "prettyName": "vscode-langservers",
         "checkName": "vscode-json-language-server",
         "description": "Needed for JSON support in neovim",
         "group": "lsp",
         "windows": {
            "installer": "npm"
         },
         "linux": {
            "elevated": true,
            "installer": "npm"
         }
      }
   ]
}
