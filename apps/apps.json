{
   "$schema": "./schema.json",
   "defaults": {
      "windows": {
         "default": "winget",
         "installers": [
            {
               "name": "winget",
               "command": "winget install --id $name --accept-package-agreements -e --scope user -h --source winget",
               "elevated": null
            },
            {
               "name": "scoop",
               "command": "scoop install $name",
               "elevated": false
            }
         ]
      },
      "debian": {
         "installers": [
            {
               "name": "apt",
               "command": "apt install $name -y",
               "elevated": true
            }
         ]
      },
      "fedora": {
         "installers": [
            {
               "name": "dnf",
               "command": "dnf install -y $name",
               "elevated": true
            }
         ]
      },
      "opensuse": {
         "installers": [
            {
               "name": "zypper",
               "command": "zypper --non-interactive install $name",
               "elevated": true
            }
         ]
      },
      "arch": {
         "default": "pacman",
         "installers": [
            {
               "name": "pacman",
               "prepare": "pacman -Syq",
               "command": "pacman -Sq --needed --noconfirm $name",
               "elevated": true
            }
         ]
      },
      "any": {
         "installers": [
            {
               "name": "npm",
               "command":"npm install -g $name"
            }
         ]
      }
   },
   "apps": [
      {
         "name": "scoop",
         "windows": {
            "elevated": false,
            "command": "powershell.exe -ExecutionPolicy RemoteSigned -Command \"Invoke-RestMethod -Uri 'https://get.scoop.sh' | Invoke-Expression\""
         
         }
      },
      {
         "name":"yay",
         "windows":false,
         "arch":{
            "elevated":false,
            "script":"arch_yay_install_script.sh"
         }
      },
      {
         "name": "flatpak",
         "linux": true
      },
      {
         "name": "fastfetch",
         "windows": {
            "name": "Fastfetch-cli.Fastfetch"
         },
         "linux": true
      },
      {
         "name": "git",
         "windows": {
            "name": "Git.Git"
         },
         "linux": true
      },
      {
         "name": "Notepad++",
         "windows": {
            "name": "Notepad++.Notepad++"
         }
      },
      {
         "name": "jq",
         "windows": {
            "name": "jqlang.jq"
         },
         "linux": true
      },
      {
         "name": "ripgrep",
         "windows": {
            "installer": "scoop"
         },
         "linux": true
      },
      {
         "name": "micro",
         "windows": {
            "name": "zyedidia.micro"
         },
         "linux": true
      },
      {
         "name": "zoxide",
         "windows": {
            "name": "ajeetdsouza.zoxide"
         },
         "linux": {
            "elevated": false,
            "command": "curl -sSfL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | sh"
         }
      },
      {
         "name": "fzf",
         "windows": {
            "name": "junegunn.fzf"
         },
         "linux": true
      },
      {
         "name": "firefox",
         "windows": {
            "name": "Mozilla.Firefox"
         },
         "opensuse": {
            "name": "MozillaFirefox"
         },
         "linux": true
      },
      {
         "name": "PowerShell",
         "checkName": "pwsh",
         "windows": {
            "name": "Microsoft.PowerShell"
         },
         "debian": {
            "script": "ubuntu_pwsh_install_script.sh"
         },
         "arch": {
            "installer":"yay",
            "name":"powershell-bin"
         }
      },
      {
         "name": "neovim",
         "checkName": "nvim",
         "any": true
      },
      {
         "name": "npm",
         "windows": {
            "name": "OpenJS.NodeJS"
         },
         "linux": {
            "name": "nodejs npm"
         }
      },
      {
         "name": "uv",
         "windows": {
            "name": "astral-sh.uv"
         },
         "linux": {
            "elevated": false,
            "command": "curl -LsSf https://astral.sh/uv/install.sh | sh"
         }
      },
      {
         "name": "ruff",
         "windows": {
            "name": "astral-sh.ruff"
         },
         "linux": {
            "elevated": false,
            "command": "curl -LsSf https://astral.sh/ruff/install.sh | sh"
         }
      },
      {
         "name": "pyright",
         "windows": {
            "elevated": null,
            "installer":"npm"
         },
         "linux": {
            "elevated": true,
            "installer":"npm"
         }
      }
   ]
}
