               "dependencies": {
                  "script": {
                     "not": {
                        "anyOf": [
                           {
                              "required": [
                                 "name"
                              ]
                           },
                           {
                              "required": [
                                 "command"
                              ]
                           },
                           {
                              "required": [
                                 "installer"
                              ]
                           }
                        ]
                     }
