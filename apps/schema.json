                  "command": {
                     "not": {
                        "anyOf": [
                           {
                              "required": [
                                 "name"
                              ]
                           },
                           {
                              "required": [
                                 "installer"
                              ]
                           }
                        ]
                     }
                  },
                  "dependencies": {
                     "not": {
                        "anyOf": [
