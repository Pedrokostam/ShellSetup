                              "required": [
                                 "command"
                              ]
                           },
                           {
                              "required": [
                                 "script"
                              ]
                           }
                        ]
                     }
                  }
               },
               "additionalProperties": false
            }
         ]
      },
      "elevation": {
         "type": [
            "boolean",
            "null"
