         "description": "Elevation policy: true = must be elevated (errors if not); false = must be non-elevated; null = will run regardless of elevation."
      },
      "appIdentifier": {
         "type": "string",
         "pattern": "^(\\S.*\\S|\\S+)$",
         "description": "Identifier of the app used when friendly name is not enough."
      },
      "dynamicCommand": {
         "description": "Command to be run to install an app. It must contain the placeholder $name, which will be replaced by the app name.",
         "oneOf": [
            {
               "type": "string",
               "pattern": "^(?=\\S(.*\\S)?$)(?=.*(?:\\$\\{name\\}|\\$name)(?=\\s|$)).+$",
               "description": "Single string command to be run to install an app. It must contain the placeholder $name, which will be replaced by the app name."
            },
            {
               "type": "array",
               "description": "String array representation of the command to be run to install an app. It must contain the placeholder $name, which will be replaced by the app name.",
               "items": {
                  "type": "string",
                  "pattern": "^\\S.*\\S"
               },
               "contains": {
                  "enum": [
                     "$name",
                     "${name}"
                  ]
               }
            }
         ]
      },
      "staticCommand": {
         "description": "Static command to be run to install the app. The command is called as-is.",
         "oneOf": [
            {
               "type": "string",
               "pattern": "^(\\S.*\\S|\\S+)$",
               "description": "Single string command to be run to install an app."
            },
            {
