      "perSystemElevation": {
         "description": "Elevation policy: true = must be elevated; false = must be non-elevated; null = runs regardless. Can also be an object mapping keys to policies with a required 'default' key.",
         "oneOf": [
            {
               "type": [
                  "boolean",
                  "null"
               ]
            },
            {
               "type": "object",
               "required": [
                  "default"
               ],
               "minProperties": 2,
               "properties": {
