{
   "$schema": "https://json-schema.org/draft-07/schema#",
   "title": "Generated Schema",
   "description": "Generated from JSON data",
   "type": "object",
   "properties": {
      "$schema": {
         "type": "string",
         "description": ""
      },
      "defaults": {
         "type": "object",
         "patternProperties": {
            "^(?!(any|linux)$)\\w+$": {
               "type": "object",
               "description": "Concrete system platform",
               "properties": {
                  "default": {
                     "$ref": "#/definitions/identifier",
                     "description": "Default installer for the platform. If not specified, the first installer will be used."
                  },
                  "installers": {
                     "$ref": "#/definitions/installers"
                  }
               },
               "if": {
                  "properties": {
                     "installers": {
                        "minItems": 2
                     }
                  }
               },
               "then": {
                  "required": [
                     "default"
                  ],
                  "description": "Must specify default installers if there are multiple available installers."
               },
               "required": [
                  "installers"
               ],
               "additionalProperties": false
            },
            "^(any|linux)$": {
               "type": "object",
               "description": "Virtual platform: a list of third-party installers that are added to every concrete platform's installers. It has no default installer.",
               "properties": {
                  "installers": {
                     "$ref": "#/definitions/installers"
                  }
               },
               "required": [
                  "installers"
               ],
               "additionalProperties": false
            }
         },
         "additionalProperties": false
      },
      "apps": {
         "type": "array",
         "description": "Apps to install",
         "items": {
            "type": "object",
            "required": [
               "name"
            ],
            "properties": {
               "name": {
                  "$ref": "#/definitions/appIdentifier"
               },
               "checkName": {
                  "oneOf": [
                     {
                        "$ref": "#/definitions/identifier",
                        "description": "The name that should be tested whether it's available in PATH. If not given will not be checked."
                     },
                     {
                        "type": "boolean",
                        "description": "Indicates whether to use app name when checking PATH for installed apps. Defaults to false."
                     }
                  ]
               },
               "group": {
                  "$ref": "#/definitions/identifier",
                  "description": "Optional group to which the app is assigned. Groups can be selectively disabled during installation. If missing, the app is assigned to the core group."
               }
            },
            "additionalProperties": false,
            "minProperties": 2,
            "patternProperties": {
               "^(windows|debian|ubuntu|arch|fedora|opensuse|linux|any)$": {
                  "oneOf": [
                     {
                        "type": "boolean",
                        "description": "Whether to use the default installer with name of containing node. A missing platform is treated as false."
                     },
                     {
                        "type": "object",
                        "description": "Installation instructions for the platform.",
                        "minProperties": 1,
                        "properties": {
                           "name": {
                              "$ref": "#/definitions/appIdentifier"
                           },
                           "installer": {
                              "$ref": "#/definitions/identifier",
                              "description": "Which installer to use, defaults to the default installer for the platform. Must refer to one of existing installers."
                           },
                           "command": {
                              "$ref": "#/definitions/identifier",
                              "description": "Custom command with which the app can be installed."
                           },
                           "script": {
                              "$ref": "#/definitions/identifier",
                              "description": "Path to the installation script. The path should be relative to the scripts folder next to this json."
                           },
                           "elevated": {
                              "$ref": "#/definitions/elevation"
                           }
                        },
                        "dependencies": {
                           "script": {
                              "not": {
                                 "anyOf": [
                                    {
                                       "required": [
                                          "name"
                                       ]
                                    },
                                    {
                                       "required": [
                                          "command"
                                       ]
                                    },
                                    {
                                       "required": [
                                          "installer"
                                       ]
                                    }
                                 ]
                              }
                           },
                           "command": {
                              "not": {
                                 "anyOf": [
                                    {
                                       "required": [
                                          "name"
                                       ]
                                    },
                                    {
                                       "required": [
                                          "installer"
                                       ]
                                    }
                                 ]
                              }
                           }
                        },
                        "additionalProperties": false
                     }
                  ]
               }
            }
         },
         "minItems": 1
      }
   },
   "definitions": {
      "installers": {
         "type": "array",
         "uniqueItems": true,
         "minItems": 1,
         "items": {
            "type": "object",
            "properties": {
               "name": {
                  "$ref": "#/definitions/identifier",
                  "description": "Name of the installer, referenced by 'default' and by an app's 'installer'."
               },
               "command": {
                  "$ref": "#/definitions/dynamicCommand",
                  "description": "Command with which apps can be installed. It must contain '$name' which will be replaced with the app name."
               },
               "executableToCheck": {
                  "$ref": "#/definitions/appIdentifier",
                  "description": "Used to check if the installer is available. If ommited, the name will be used."
               },
               "prepare": {
                  "$ref": "#/definitions/staticCommand",
                  "description": "Optional command to execute before installing the first app with that installer."
               },
               "elevated": {
                  "$ref": "#/definitions/elevation"
               }
            },
            "required": [
               "name",
               "command"
            ],
            "additionalProperties": false
         }
      },
      "identifier": {
         "type": "string",
         "pattern": "^(\\S.*\\S|\\S+)$"
      },
      "elevation": {
         "type": [
            "boolean",
            "null"
         ],
         "description": "Elevation policy: true = must be elevated (errors if not); false = must be non-elevated; null = will run regardless of elevation."
      },
      "appIdentifier": {
         "type": "string",
         "pattern": "^(\\S.*\\S|\\S+)$",
         "description": "Identifier of the app used when friendly name is not enough."
      },
      "dynamicCommand": {
         "type": "string",
         "pattern": "^\\S.*\\$name(?![A-Za-z0-9_]).*$",
         "description": "Command to be run to install an app. It must contain the placeholder $name, which will be replaced by the app name."

      },
      "staticCommand": {
         "type": "string",
         "pattern": "^(\\S.*\\S|\\S+)$",
         "description": "Static command to be run to install the app. The command is called as-is."
      }
   }
}
