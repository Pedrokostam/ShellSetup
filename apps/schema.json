               "command": {
                  "$ref": "#/definitions/dynamicCommand",
                  "description": "Command with which apps can be installed. It must contain '$name' which will be replaced with the app name."
               },
               "executableToCheck": {
                  "$ref": "#/definitions/appIdentifier",
                  "description": "Used to check if the installer is available. If ommited, the name will be used."
               },
               "prepare": {
