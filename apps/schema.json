                     "$ref": "#/definitions/elevation"
                  },
                  "fedora": {
                     "$ref": "#/definitions/elevation"
                  },
                  "opensuse": {
                     "$ref": "#/definitions/elevation"
                  },
                  "linux": {
                     "$ref": "#/definitions/elevation"
                  }
               },
               "additionalProperties": false
            }
         ]
      },
      "appPlatformConfig": {
         "oneOf": [
            {
               "type": "boolean",
               "default": true,
               "description": "Whether to use the default installer with name of containing node. A missing platform is treated as false."
