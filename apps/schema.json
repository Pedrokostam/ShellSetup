                  "command": {
                     "$ref": "#/definitions/identifier",
                     "description": "Custom command with which the app can be installed."
                  },
                  "script": {
                     "$ref": "#/definitions/identifier",
                     "description": "Path to the installation script. The path should be relative to the scripts folder next to this json."
                  },
                  "elevated": {
                     "$ref": "#/definitions/elevation"
